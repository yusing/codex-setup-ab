  "id": "express-transfer-encoding",
  "source": {
    "repository": "https://github.com/expressjs/express.git",
    "base_commit": "59e205a57a04fced6bb7b8ec0b5dec29461a9996",
    "forbidden_commit": "18e5985b8a9d5e8423db0a9121f22bdaecd5b120",
