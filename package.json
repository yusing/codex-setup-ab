{
  "name": "codex-ab",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "codex-ab": "./dist/codex-ab"
  },
  "scripts": {
    "start": "bun cli.ts serve",
    "build": "bun build ./cli.ts --compile --outfile ./dist/codex-ab",
    "test": "bun test --parallel=6",
    "check:docs": "bun scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:docs && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
