# Model-free boundary fixtures: no user credentials or production source images.
FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS node-toolchain
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-venv git util-linux ca-certificates curl libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY tasks/flask-ipv6-server-name/requirements.txt /tmp/flask-qualification-requirements.txt
RUN python3 -m venv /opt/task-deps/python \
    && /opt/task-deps/python/bin/pip install --no-cache-dir -r /tmp/flask-qualification-requirements.txt
COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
RUN curl -fsSL https://chatgpt.com/codex/install.sh -o /tmp/codex-install.sh \
    && CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin CODEX_NON_INTERACTIVE=1 \
        sh /tmp/codex-install.sh \
    && rm /tmp/codex-install.sh \
    && ln -s /opt/codex/packages/standalone/current/bin/codex-code-mode-host \
        /usr/local/bin/codex-code-mode-host \
    && test -x /usr/local/bin/codex-code-mode-host
ARG FIXTURE_UID=1001
ARG FIXTURE_GID=1001
RUN mkdir -p /home/ubuntu/.codex /workspace && chown -R ${FIXTURE_UID}:${FIXTURE_GID} /home/ubuntu /workspace
ENV HOME=/home/ubuntu CODEX_HOME=/home/ubuntu/.codex
WORKDIR /workspace
USER ${FIXTURE_UID}:${FIXTURE_GID}
ENTRYPOINT []
# Node and the standalone Codex must run as the fixture UID.
RUN node --version && bun --version && python3 --version && git --version && codex --version
